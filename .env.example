# 可选：本地开发用。正式演示建议让用户在网页侧边栏自行填写 API Key。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# 请求体总大小限制，默认约 1.5MB。
MAX_BODY_BYTES=1500000

# API 写请求限流。设为 0 可关闭；公开部署不建议关闭。
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# 每个客户端同时允许的模型生成任务数。设为 0 可关闭。
MAX_CONCURRENT_GENERATIONS_PER_CLIENT=1

# 只有确认反向代理会覆盖并清洗 X-Forwarded-For 时才启用。
TRUST_PROXY_HEADERS=false

# 主要业务输入字符上限，可按模型上下文和部署资源调整。
MAX_MEETING_CHARS=30000
MAX_CONTRACT_CHARS=50000
MAX_POLICY_DEMAND_CHARS=20000
MAX_MATCH_TOTAL_CHARS=30000
MAX_REPORT_TOTAL_CHARS=200000

# 同域部署默认不需要 CORS，留空即不启用跨域访问。
# 前后端分离时只填写明确允许的来源，多个来源使用逗号分隔。
# CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=

# 默认禁止使用 CORS 通配符。只有临时调试且充分理解风险时才启用。
ALLOW_WILDCARD_CORS=false

# 仅在正式 HTTPS 域名部署后启用 HSTS；不要在仍需 HTTP 访问的环境中开启。
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# 可选：覆盖默认浏览器安全策略。通常无需修改。
# CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'
# PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=()
