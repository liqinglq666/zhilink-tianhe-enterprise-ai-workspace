# 比赛公共模型：只保存在服务端环境变量中，绝不能写入前端代码或提交到 Git。
PUBLIC_MODEL_ENABLED=false
PUBLIC_MODEL_API_KEY=
PUBLIC_MODEL_PROVIDER=阿里云百炼 DashScope
PUBLIC_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PUBLIC_MODEL_MODEL=qwen-plus
PUBLIC_MODEL_TEMPERATURE=0.35
# 进程级体验保险丝；多实例正式部署还应使用共享配额和供应商预算上限。
PUBLIC_MODEL_DAILY_REQUEST_LIMIT=200
ALLOW_USER_API_OVERRIDE=true

# 兼容本地脚本或后端私有调用。OPENAI_API_KEY 不会自动开放成公共 Key。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# 模型网关安全。正式企业部署建议配置 allowlist 并开启强制模式。
LLM_ALLOWED_HOSTS=
LLM_REQUIRE_HOST_ALLOWLIST=false
ALLOW_INSECURE_LLM_HTTP=false
# 服务端模型输出硬上限，同时向兼容接口传递 max_tokens，避免失控输出和费用放大。
MODEL_MAX_COMPLETION_TOKENS=8192
MODEL_MAX_OUTPUT_CHARS=120000

# 项目、版本历史、账号和组织共用数据库。
# 默认使用本地 SQLite；正式多实例部署建议切换 PostgreSQL。
DATABASE_URL=sqlite:///./runtime/zhilink.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/zhilink

# 账号和会话。
AUTH_ALLOW_REGISTRATION=true
PASSWORD_MIN_LENGTH=10
SESSION_TTL_HOURS=168
# 本地 HTTP 开发保持 false；正式 HTTPS 域名必须设为 true。
AUTH_COOKIE_SECURE=false
SESSION_COOKIE_NAME=zhilink_session
CSRF_COOKIE_NAME=zhilink_csrf

# 官方政策检索。默认只读取 allowlist 政府域名目录与详情页。
POLICY_RETRIEVAL_ENABLED=true
POLICY_CATALOG_URLS=https://www.thnet.gov.cn/zjth/tzth/tzzc/thzc/;https://www.thnet.gov.cn/zwgk/zcjd/
POLICY_ALLOWED_DOMAINS=thnet.gov.cn,gz.gov.cn,gd.gov.cn,gov.cn
POLICY_FETCH_TIMEOUT_SECONDS=6
POLICY_CACHE_TTL_SECONDS=900
POLICY_MAX_CATALOG_PAGES=4
POLICY_MAX_RESULTS=6

# 请求体总大小限制，默认约 1.5MB。
MAX_BODY_BYTES=1500000

# API 写请求限流。公开比赛部署建议降低到 8-12 次/分钟。
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_GENERATIONS_PER_CLIENT=1

# 模型请求超时。
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_TEST_TIMEOUT_SECONDS=20

# 浏览器流式控制：30 秒连接超时、120 秒无输出超时、10 分钟硬上限。
# 服务端仍以 MODEL_MAX_* 为最终安全边界。

# 只有确认反向代理会覆盖并清洗 X-Forwarded-For 时才启用。
TRUST_PROXY_HEADERS=false

# 主要业务输入字符上限。
MAX_MEETING_CHARS=30000
MAX_CONTRACT_CHARS=50000
MAX_POLICY_DEMAND_CHARS=20000
MAX_MATCH_TOTAL_CHARS=30000
MAX_REPORT_TOTAL_CHARS=200000

# 同源部署通常无需 CORS。
CORS_ALLOW_ORIGINS=
ALLOW_WILDCARD_CORS=false

# 仅在正式 HTTPS 域名部署后启用 HSTS。
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# 可选：覆盖默认浏览器安全策略。通常无需修改。
# CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'
# PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=()
